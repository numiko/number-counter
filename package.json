{
  "name": "@numiko/number-counter",
  "description": "Number Counter",
  "version": "0.2.3",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@bitbucket.org/numiko/number-counter.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest --run --reporter junit --outputFile ./reports/results.xml --coverage.enabled --coverage.include lib --coverage.reporter=html --coverage.reportsDirectory ./reports/",
    "generate-docs": "typedoc lib/NumberCounter.ts --plugin typedoc-plugin-markdown --mergeReadme true --readme none --plugin typedoc-plugin-mdn-links --publicPath https://bitbucket.org/numiko/number-counter/src/main/",
    "release": "release-it"
  },
  "main": "./dist/NumberCounter.umd.js",
  "files": [
    "dist",
    "package.json",
    "README.md",
    "docs/**/*.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/NumberCounter.d.ts",
      "import": "./dist/NumberCounter.es.js",
      "require": "./dist/NumberCounter.umd.js"
    }
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/node": "^24.7.2",
    "@vitest/coverage-v8": "^2.1.3",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "happy-dom": "^15.7.4",
    "release-it": "^17.10.0",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typedoc-plugin-mdn-links": "^5.0.10",
    "typescript-eslint": "^8.46.1",
    "vite": "^5.4.9",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "gsap": "^3.12.5"
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it/schema/release-it.json",
    "npm": {
      "publish": true,
      "publishArgs": [
        "--access",
        "public"
      ]
    },
    "hooks": {
      "before:init": [
        "vitest run"
      ],
      "after:bump": [
        "npm run generate-docs",
        "npm run build"
      ]
    }
  }
}
